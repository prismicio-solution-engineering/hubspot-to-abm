SESSION_SECRET=generate-a-long-random-string
HUBSPOT_CLIENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_CLIENT_SECRET=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
HUBSPOT_REDIRECT_URI=http://localhost:3000/api/auth/hubspot/callback
HUBSPOT_SCOPES=oauth crm.lists.read crm.objects.contacts.read crm.objects.companies.read
OPENAI_KEY=sk-...
PRISMIC_REPOSITORY=your-repository-name
PRISMIC_MASTER_TOKEN=MC5...
PRISMIC_WRITE_TOKEN=...

# Optional: override Prismic credentials per prototype demo.
# For demo id "martech-madrid", the env prefix is MARTECH_MADRID.
PRISMIC_MARTECH_MADRID_REPOSITORY=template-landing
PRISMIC_MARTECH_MADRID_MASTER_TOKEN=MC5...
PRISMIC_MARTECH_MADRID_WRITE_TOKEN=...
